	"tokenColors": [
		{
			"name": "Comments",
			"scope": [
				"comment",
				"punctuation.definition.comment",
				"string.comment"
			],
			"settings": {
				"foreground": "#8C8A82",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Keywords and storage",
			"scope": [
				"keyword",
				"keyword.control",
				"storage",
				"storage.type",
				"storage.modifier",
				"keyword.operator.new",
				"keyword.operator.expression",
				"keyword.operator.logical.python",
				"variable.language.this",
				"variable.language.self",
				"variable.language.super"
			],
			"settings": {
				"foreground": "#C15F3C"
			}
		},
		{
			"name": "Operators and punctuation",
			"scope": [
				"keyword.operator",
				"punctuation",
				"meta.brace",
				"punctuation.definition.parameters",
				"punctuation.separator",
				"punctuation.terminator"
			],
			"settings": {
				"foreground": "#6F6D66"
			}
		},
		{
			"name": "Functions",
			"scope": [
				"entity.name.function",
				"meta.function-call entity.name.function",
				"support.function",
				"meta.require",
				"support.function.any-method",
				"keyword.other.special-method"
			],
			"settings": {
				"foreground": "#2D6A9F"
			}
		},
		{
			"name": "Types and classes",
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"entity.name.namespace",
				"entity.other.inherited-class",
				"support.type",
				"support.class",
				"meta.class",
				"storage.type.java",
				"storage.type.cs",
				"entity.name.type.class"
			],
			"settings": {
				"foreground": "#8B5E1A"
			}
		},
		{
			"name": "Strings",
			"scope": [
				"string",
				"punctuation.definition.string",
				"constant.other.symbol",
				"markup.raw.inline",
				"markup.inline.raw"
			],
			"settings": {
				"foreground": "#577A2F"
			}
		},
		{
			"name": "Embedded expressions in strings",
			"scope": [
				"punctuation.definition.template-expression",
				"punctuation.section.embedded",
				"variable.interpolation",
				"string source",
				"meta.embedded"
			],
			"settings": {
				"foreground": "#1F1E1B"
			}
		},
		{
			"name": "Numbers and constants",
			"scope": [
				"constant",
				"constant.numeric",
				"constant.language",
				"support.constant",
				"variable.other.constant",
				"variable.other.enummember",
				"entity.name.constant",
				"keyword.other.unit"
			],
			"settings": {
				"foreground": "#A0457A"
			}
		},
		{
			"name": "Regex and escapes",
			"scope": [
				"string.regexp",
				"source.regexp",
				"constant.character.escape",
				"constant.other.character-class.regexp"
			],
			"settings": {
				"foreground": "#2E8A82"
			}
		},
		{
			"name": "Parameters",
			"scope": [
				"variable.parameter",
				"variable.parameter.function",
				"meta.parameters variable"
			],
			"settings": {
				"foreground": "#9C5B3A",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Variables and properties",
			"scope": [
				"variable",
				"variable.other",
				"variable.other.readwrite",
				"variable.other.property",
				"variable.other.object",
				"support.variable",
				"meta.property-name"
			],
			"settings": {
				"foreground": "#1F1E1B"
			}
		},
		{
			"name": "JSON and YAML keys",
			"scope": [
				"support.type.property-name.json",
				"entity.name.tag.yaml",
				"support.type.property-name.toml"
			],
			"settings": {
				"foreground": "#C15F3C"
			}
		},
		{
			"name": "Tags",
			"scope": [
				"entity.name.tag",
				"punctuation.definition.tag",
				"support.class.component"
			],
			"settings": {
				"foreground": "#C15F3C"
			}
		},
		{
			"name": "Attributes",
			"scope": [
				"entity.other.attribute-name",
				"entity.other.attribute-name.class.css",
				"entity.other.attribute-name.id.css"
			],
			"settings": {
				"foreground": "#8B5E1A"
			}
		},
		{
			"name": "CSS properties",
			"scope": [
				"support.type.property-name.css",
				"support.type.vendored.property-name.css"
